generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prismaMongo"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_MONGO")
}

type ChatMensajes {
  contenido   String
  fechaEnvio  String
  remitenteId String
}

type DocumentosIdCloudinary {
  cloudinary_id String
  name          String
  url           String
}

model Chat {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime       @db.Date
  idPublicacion        String
  idUsuarioCliente     String
  idUsuarioPropietario String
  mensajes             ChatMensajes[]
  updatedAt            DateTime       @db.Date
}

model Documentos {
  id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime                 @db.Date
  id_cloudinary DocumentosIdCloudinary[]
  id_usuario    String
  nombreEmpresa String
}
